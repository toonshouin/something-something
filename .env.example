# ==============================================================================
# Resume/CV Application Environment Variables (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit your real .env file with secrets to Git.
# - Do NOT prefix private access variables with NEXT_PUBLIC_ or PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Access Control & Cookie Security
# ------------------------------------------------------------------------------
# Global fallback secret token for unlocking full address via ?token=<SECRET_TOKEN>
SECRET_TOKEN="replace_with_a_secure_master_token_for_fallback"

# Random secret key used to sign HMAC-SHA256 session cookies (resume_session).
# Generate one using: openssl rand -hex 32
SESSION_SECRET="replace_with_a_random_32_or_64_char_secret_string"

# ------------------------------------------------------------------------------
# 2. Baserow Database Integration (Dynamic Access & Address)
# ------------------------------------------------------------------------------
# Base URL of your self-hosted or cloud Baserow instance (omit trailing slash)
BASEROW_API_URL="https://baserow.yourdomain.com"

# Baserow Database Token generated in Baserow Settings > Database Tokens
BASEROW_DATABASE_TOKEN="Token your_database_token_here"

# Numeric Table IDs from your Baserow database URL (e.g. /database/123/table/456)
BASEROW_ADDRESS_TABLE_ID="456"
BASEROW_GRANT_TABLE_ID="457"
BASEROW_LOG_TABLE_ID="458"

# ------------------------------------------------------------------------------
# 3. Optional Offline Address Fallback (JSON String)
# ------------------------------------------------------------------------------
# Used ONLY if Baserow is offline or unconfigured.
# Never commit real personal street addresses in this example file.
PRIVATE_ADDRESS_JSON='{"en":{"house_no":"123/45","road":"Main Rd.","sub_district":"Bang Talat","district":"Pak Kret","province":"Nonthaburi","zip_code":"11120","country":"Thailand"},"th":{"house_no":"123/45","road":"ถ.แจ้งวัฒนะ","sub_district":"บางตลาด","district":"ปากเกร็ด","province":"นนทบุรี","zip_code":"11120","country":"ไทย"}}'
